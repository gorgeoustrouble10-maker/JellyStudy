{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.autobuild.enabled": true,
    "java.compile.nullAnalysis.mode": "disabled",
    "java.jdt.lombokSupport.enabled": true,
    "java.import.maven.enabled": true,
    "java.maven.downloadSources": true,
    "java.eclipse.downloadSources": true,
    "java.configuration.maven.notCoveredPluginExecutionSeverity": "ignore",
    "java.configuration.checkProjectSettingsExclusions": false,
    "java.errors.incompleteClasspath.severity": "warning",
    "maven.executable.path": "${workspaceFolder}/tools/apache-maven-3.9.6/bin/mvn.cmd",
    "java.jdt.ls.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.7.6-hotspot",
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/frontend/**",
        "**/tools/**",
        "**/skywalking-agent/**",
        "**/logs/**"
    ],
    "java.project.resourceFilters": [
        "node_modules",
        ".git",
        "frontend",
        "tools",
        "logs",
        "skywalking-agent"
    ],
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.7.6-hotspot",
            "default": true
        }
    ],
    "java.project.sourceLevel": "17",
    "java.project.targetLevel": "17",
    "files.watcherExclude": {
        "**/target/**": true,
        "**/node_modules/**": true
    },
    "files.exclude": {
        "**/target": true
    },
    "markdown.mermaid.enabled": true
}
