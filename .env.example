# 复制为 .env 或在启动前 set（Windows）
# 评估：mock（默认）或 qianwen
EVALUATE_MODEL_TYPE=mock
# DASHSCOPE_API_KEY=sk-你的通义千问密钥

# 基础设施
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=jellystudy_redis
NACOS_HOST=127.0.0.1
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# 评估：默认 qianwen；无有效 sk- 密钥时自动 Mock
EVALUATE_MODEL_TYPE=qianwen

# 可选 API 保护（默认关闭，本地演示无需配置）
JELLYSTUDY_SECURITY_ENABLED=false
# JELLYSTUDY_API_KEY=change-me-in-production
# JELLYSTUDY_CORS_ORIGINS=http://127.0.0.1:9945,http://localhost:9945

# 写操作 Bearer 鉴权（默认开启；问答/知识点 POST/PUT/DELETE 需登录 Token）
JELLYSTUDY_BEARER_WRITE_ENABLED=true

# Swagger（生产 profile 自动关闭；开发可手动关）
SWAGGER_ENABLED=true

# 前端（与后端 JELLYSTUDY_API_KEY 一致，仅在开启安全时填写）
# VITE_JELLYSTUDY_API_KEY=

# SkyWalking Agent（start-with-skywalking.bat 使用）
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
